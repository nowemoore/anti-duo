# Copy this file to  .env.local  and fill in your real Supabase values, then restart the dev server.
# (Supabase dashboard → Project Settings → API. The project URL is https://<project-id>.supabase.co)
#
# Both are optional: with neither set, the app runs exactly as before and the Settings → Cloud backup
# card says it isn't configured. Progress then lives in this browser (or your local server) only.
#
# VITE_* variables are inlined into the bundle at build time, so the anon key ships inside any build
# — it's a *publishable* key, not a secret. Your data is protected by row-level security on the
# `progress` table (see supabase/progress.sql), not by hiding this key. .env.local is gitignored.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
